# Frontend environment variables
NEXT_PUBLIC_API_URL=http://localhost:5000
URL=http://localhost:3000
STRIPEPUBLIC=pk_test_replace_me
LOCK=false
CHARITIES_API=replace_me
# Live FX rates — JSON mapping currency -> rate-to-USD for dual-currency preview (optional).
# Example: {"USD":1,"GBP":1.28,"EUR":1.08,"NGN":0.00065,"KES":0.0077,"GHS":0.065}
NEXT_PUBLIC_FX_RATES_JSON=
# Optional live endpoint for runtime refresh (GET returns { rates: { USD: 1, ... } })
NEXT_PUBLIC_FX_RATES_URL=
# Node 22+ compatibility: Next.js 15 requires --openssl-legacy-provider
NODE_OPTIONS=--openssl-legacy-provider
