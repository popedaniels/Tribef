# Keep secrets and local artifacts out of the image build context.
# The backend Dockerfile COPYs the whole context into the runner stage, so
# anything listed here would otherwise be baked into the image layers.

# Environment / secrets — never in the context
.env
.env.*
!.env.example

# Logs
debug.log
yarn-error.log
npm-debug.log*
logs/
*.log

# Dependencies (installed inside the image)
node_modules

# Tests, coverage and CI artifacts
tests
coverage
.nyc_output
.github

# Git and editor state
.git
.gitignore
.vscode

# Docs and misc
*.md
Dockerfile
docker-compose.yml
