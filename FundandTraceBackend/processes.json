{
    "apps": [
        {
            "name": "api",
            "script": "server.js",
            "exec_mode": "cluster",
            "instances": 4,
            "merge_logs": true,
            "max_restarts": 20,
            "min_uptime": "30s",
            "max_memory_restart": "512M",
            "kill_timeout": 16000,
            "listen_timeout": 10000,
            "env": {
                "PORT": 5000,
                "NODE_ENV": "production"
            }
        }
    ]
}
