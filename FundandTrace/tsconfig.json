{
  "compilerOptions": {
    "target": "esnext",
    "lib": [
      "dom",
      "es2017"
    ],
    "skipLibCheck": true,
    "strict": true,
    "noImplicitAny": true,
    "useUnknownInCatchVariables": false,
    "forceConsistentCasingInFileNames": true,
    "module": "commonjs",
    "jsx": "preserve",
    "allowJs": true,
    "strictNullChecks": true,
    "outDir": "./dist",
    "rootDir": ".",
    "types": [
      "node",
      "react",
      "jest",
      "@testing-library/jest-dom"
    ],
    "noEmit": true,
    "esModuleInterop": true,
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "incremental": true
  },
  "include": [
    "src/**/*",
    "store/**/*"
  ],
  "exclude": [
    "node_modules",
    ".next"
  ]
}
